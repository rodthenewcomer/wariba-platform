  "shared_calculation_rules": {
    "money": {
      "typescript_runtime": "Decimal.js",
      "database_type": "numeric",
      "api_serialization": "string",
      "rounding_mode": "must_be_explicit_per_calculation"
    },
    "time": {
      "storage": "UTC",
      "daily_reset_time": "00:00:00",
      "daily_reset_timezone": "UTC",
      "clock_injection_required": true
    },
    "equity": {
      "formula": "balance + unrealized_pnl - accrued_costs",
      "authoritative_side": "server"
    },
    "realized_net_profit": {
      "formula": "realized_pnl - commissions - swaps - other_published_trading_costs",
      "includes_unrealized_pnl": false
    },
    "trading_day": {
      "definition": "a UTC calendar day containing at least one accepted fill",
      "finalized_only_after_day_close": true
    },
    "qualified_day": {
      "definition": "a finalized UTC trading day whose realized_net_profit is greater than or equal to the account-specific threshold",
      "unrealized_pnl_counted": false
    },
    "consistency": {
      "formula": "best_profitable_finalized_day_realized_net_profit / total_realized_net_profit_in_scope",
      "scope_isolation_required": true,
      "evaluation_scope": "entire_evaluation",
      "performance_scope": "current_performance_cycle_only",
      "when_total_realized_net_profit_lte_zero": {
        "ratio": null,
        "status": "not_eligible"
      },
      "breach_capable": false,
      "eligibility_only": true
    },
    "daily_loss": {
      "start_of_day_equity_formula": "balance_at_daily_reset + unrealized_pnl_at_daily_reset - accrued_costs_at_daily_reset",
      "current_adjusted_equity_formula": "current_balance + current_unrealized_pnl - current_accrued_costs",
      "used_formula": "max(0, start_of_day_equity - current_adjusted_equity)",
      "soft_lock_only": true,
      "hard_breach_only_if_maximum_loss_floor_is_reached": true
    },
    "maximum_loss": {
      "floor_formula": "nominal_balance * (1 - maximum_loss_rate)",
      "reference": "current_equity",
      "static": true,
      "trailing": false,
      "hard_breach": true
    }
  },
