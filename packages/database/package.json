{
  "name": "@wariba/database",
  "version": "0.0.0",
  "private": true,
  "description": "Kysely database types, transaction helpers, repositories, locks and outbox.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude 'tests/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/activation.integration.test.ts tests/trading.integration.test.ts tests/trading-properties.integration.test.ts",
    "test:rls": "vitest run --testTimeout=15000 tests/identity-commerce-rls.integration.test.ts tests/trading-rls.integration.test.ts"
  },
  "dependencies": {
    "@wariba/domain": "workspace:*",
    "kysely": "^0.28.17",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "decimal.js": "^10.4.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
