# WARIBA Web — environment contract.
#
# NEXT_PUBLIC_* are inlined at BUILD time and are public by definition.
# Everything else is read at run time and must never be a build argument.

# --- build time AND run time (public) ---------------------------------------
# These are inlined into the client bundle at build time *and* re-validated by
# the server's instrumentation hook at startup. Supplying them only at build
# time makes the container start and then fail every request with a config
# error — verified in 3.1A. They must be present in both places.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REALTIME_WS_URL=       # wss://…/ws

# --- run time (secret) ------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server only — never expose to the client
SANDBOX_WEBHOOK_SECRET=

# --- run time (config) ------------------------------------------------------
APP_ENV=staging                    # local | preview | staging | production
APP_BASE_URL=
WEB_PORT=3000
PAYMENT_PROVIDER=sandbox           # see apps/web/lib/config.ts for the enum
PAYOUT_PROVIDER=mock                # mock | manual
