# Everything the image must never carry.
#
# Secrets first: .env* is listed before anything else because a leaked build
# context is the most common way credentials reach a registry, and this repo
# keeps real credentials in .env.local.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

node_modules
**/node_modules
.next
**/.next
**/dist
**/.turbo
.turbo
**/tsconfig.tsbuildinfo
coverage
**/test-results
**/playwright-report
**/.visual-verify
output

.git
.github
docs
supabase/tests
**/*.test.ts
**/*.test.tsx
**/tests
scripts/visual-verify.mjs

.DS_Store
**/.DS_Store
