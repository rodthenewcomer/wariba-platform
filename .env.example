# WARIBA — variable names only. Never commit real values.
# See WARIBA Engineering Constitution v1.0 §43 (Secrets) and §54 (Configuration).

# --- Runtime ---
# NODE_ENV is owned by Node/Next.js and must not be declared in env files.
# WARIBA's own environment concept (local|preview|staging|production) is APP_ENV.
APP_ENV=
LOG_LEVEL=

# --- Web / BFF ---
WEB_PORT=
APP_BASE_URL=

# --- Realtime ---
REALTIME_PORT=
REALTIME_WS_URL=
NEXT_PUBLIC_REALTIME_WS_URL=
INSTANCE_ID=
LEADER_LEASE_DURATION_MS=4000
LEADER_RENEW_INTERVAL_MS=1000
SANDBOX_MARKET_SEED=
MARKET_TICK_INTERVAL_MS=

# --- Worker ---
WORKER_POLL_INTERVAL_MS=
# Bearer token required on POST /jobs/daily-finalization — this endpoint
# triggers a financial-state-mutating batch job on demand.
WORKER_ADMIN_TOKEN=

# P09-DEV-SAFETY-001. With APP_ENV=local, the web, realtime and worker
# processes refuse to start against a non-local DATABASE_URL/SUPABASE_URL.
# Set to exactly "true" to accept writing to a remote project on purpose;
# any other value (including "1") keeps the guard on. Never set this in a
# committed env file.
WARIBA_ALLOW_REMOTE_DATA_PLANE=

# --- Supabase (local/staging/production — never share across environments) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_DB_PASSWORD=
DATABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL/anon key as above, duplicated under NEXT_PUBLIC_ so Next.js inlines
# them into the browser bundle — the anon key is designed to be public (RLS
# enforces the real boundary), never the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sandbox providers (fail-fast if these resolve to a sandbox value in production) ---
SANDBOX_WEBHOOK_SECRET=
MARKET_DATA_PROVIDER=
PAYMENT_PROVIDER=
# mock | manual; both are non-production providers and fail-fast in APP_ENV=production.
PAYOUT_PROVIDER=manual
EMAIL_PROVIDER=

# --- Market data (Prompt 07B / Appendix 07-A) ---
# MARKET_DATA_PROVIDER selects the adapter: mock | replay | fcs.
# mock/replay must fail assertNotSandboxInProduction just like the legacy
# "sandbox" value — never selectable in production without a real FCS key.
MARKET_DATA_ENABLED=
MARKET_DATA_REPLAY_MODE=
# FCS Business API (WebSocket + REST). Leave empty until a real credential
# exists — FcsMarketDataProvider must fail fast rather than fake a connection.
FCS_API_KEY=
FCS_WS_PRIMARY_URL=
FCS_WS_SECONDARY_URL=
FCS_REST_BASE_URL=
# JSON map of internal WARIBA symbol -> provider symbol, populated once the
# FCS symbol catalogue has been resolved (Appendix 07-A §2). Empty until then.
FCS_SYMBOL_MAP=

# --- WX3 historical market data -------------------------------------------
# The chart's candle archive. Independent of MARKET_DATA_PROVIDER: WX3 changes
# where candles come from, not where ticks come from. 'none' is the WX2
# behaviour — WariX serves only the observations it genuinely owns and
# fabricates nothing to fill the difference.
MARKET_HISTORY_PROVIDER=none

# Twelve Data (production candidate). A Basic key is free and covers FX and
# metals; indices need Grow or Venture. External customer display is NOT
# covered by the free tier — see WARIX_WX3_PROVIDER_EVALUATION.md.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_SYMBOL_MAP=EURUSD=EUR/USD,GBPUSD=GBP/USD,USDJPY=USD/JPY,XAUUSD=XAU/USD

# OANDA (development/staging only). Its licence prohibits third-party display,
# so the adapter refuses to construct under APP_ENV=production.
OANDA_API_TOKEN=
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_ENVIRONMENT=practice
OANDA_SYMBOL_MAP=EURUSD=EUR_USD,GBPUSD=GBP_USD,USDJPY=USD_JPY,XAUUSD=XAU_USD,NAS100=NAS100_USD

# Provider pacing. Sized for a Twelve Data Basic key (8 credits/minute).
MARKET_HISTORY_RATE_LIMIT=6
MARKET_HISTORY_RATE_WINDOW_MS=60000

# Historical/realtime cutover. 'verified' refuses to draw live ticks onto
# provider history when the two sources describe different markets.
MARKET_HISTORY_CUTOVER=verified
MARKET_HISTORY_CUTOVER_TOLERANCE_BPS=50
