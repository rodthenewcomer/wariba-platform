# WARIBA — variable names only. Never commit real values.
# See WARIBA Engineering Constitution v1.0 §43 (Secrets) and §54 (Configuration).

# --- Runtime ---
# NODE_ENV is owned by Node/Next.js and must not be declared in env files.
# WARIBA's own environment concept (local|preview|staging|production) is APP_ENV.
APP_ENV=
LOG_LEVEL=

# --- Web / BFF ---
WEB_PORT=
APP_BASE_URL=

# --- Realtime ---
REALTIME_PORT=
REALTIME_WS_URL=
NEXT_PUBLIC_REALTIME_WS_URL=
SANDBOX_MARKET_SEED=
MARKET_TICK_INTERVAL_MS=

# --- Worker ---
WORKER_POLL_INTERVAL_MS=

# --- Supabase (local/staging/production — never share across environments) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_DB_PASSWORD=
DATABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL/anon key as above, duplicated under NEXT_PUBLIC_ so Next.js inlines
# them into the browser bundle — the anon key is designed to be public (RLS
# enforces the real boundary), never the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sandbox providers (fail-fast if these resolve to a sandbox value in production) ---
SANDBOX_WEBHOOK_SECRET=
MARKET_DATA_PROVIDER=
PAYMENT_PROVIDER=
PAYOUT_PROVIDER=
EMAIL_PROVIDER=
