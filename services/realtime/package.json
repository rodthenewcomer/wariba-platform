{
  "name": "@wariba/realtime",
  "version": "0.0.0",
  "private": true,
  "description": "WARIBA Realtime Engine — Fastify + WebSocket process (foundation: health endpoint only).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "lint": "eslint --config ../../eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude 'tests/*.e2e.test.ts'",
    "test:e2e": "pnpm test:e2e:full",
    "test:e2e:smoke": "vitest run --no-file-parallelism tests/auth-isolation.e2e.test.ts tests/pending-order-lifecycle.e2e.test.ts",
    "test:e2e:pending": "vitest run --no-file-parallelism tests/pending-order-lifecycle.e2e.test.ts",
    "test:e2e:full": "vitest run --no-file-parallelism tests/auth-isolation.e2e.test.ts tests/pending-order-lifecycle.e2e.test.ts",
    "test:recovery": "vitest run --no-file-parallelism tests/pending-order-restart-recovery.e2e.test.ts",
    "test:failover": "vitest run --no-file-parallelism tests/multi-node-failover.e2e.test.ts",
    "test:load": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "@supabase/supabase-js": "^2.47.10",
    "@wariba/adapters": "workspace:*",
    "@wariba/config": "workspace:*",
    "@wariba/contracts": "workspace:*",
    "@wariba/database": "workspace:*",
    "@wariba/domain": "workspace:*",
    "@wariba/observability": "workspace:*",
    "decimal.js": "^10.4.3",
    "fastify": "^5.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
