# WARIBA Realtime — environment contract.
#
# Every value arrives at run time. Nothing here is baked into the image.
# A variable with no default MUST be supplied or the process exits at startup
# (services/realtime/src/config.ts validates with zod and fails closed).

# --- required ---------------------------------------------------------------
APP_ENV=staging                    # local | preview | staging | production
DATABASE_URL=                      # postgresql://…  managed Postgres, pooled
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- service ----------------------------------------------------------------
REALTIME_PORT=4001
INSTANCE_ID=                       # unique per replica; leadership fencing key
LOG_LEVEL=info

# --- leadership -------------------------------------------------------------
# The lease duration is the worst-case takeover time if an instance dies
# *without* releasing. Graceful SIGTERM shutdown releases immediately, so this
# only bounds hard kills.
LEADER_LEASE_DURATION_MS=15000
LEADER_RENEW_INTERVAL_MS=5000

# --- market data ------------------------------------------------------------
# mock | replay | fcs | twelve-data.  Staging starts on `replay`.
# Switching to a real provider is 3.1B and requires DATA-011 + OPEN-DATA-001.
MARKET_DATA_PROVIDER=replay
MARKET_DATA_ENABLED=true
# Safety override: forces replay regardless of MARKET_DATA_PROVIDER, so a real
# provider can be staged and reviewed before it is allowed to emit.
MARKET_DATA_REPLAY_MODE=false

# --- provider credentials (3.1B — leave empty until the account exists) ------
FCS_API_KEY=
TWELVE_DATA_API_KEY=
OANDA_API_TOKEN=

# Display rights are a separate decision from having a key (OPEN-DATA-001).
MARKET_HISTORY_DISPLAY_RIGHTS=false
