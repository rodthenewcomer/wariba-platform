# WARIBA Worker — environment contract.
#
# Validated by services/worker/src/config.ts. Fails closed at startup.

# --- required ---------------------------------------------------------------
APP_ENV=staging                    # local | preview | staging | production
DATABASE_URL=
WORKER_ADMIN_TOKEN=                # bearer token for POST /jobs/daily-finalization

# --- service ----------------------------------------------------------------
WORKER_HEALTH_PORT=4002
WORKER_POLL_INTERVAL_MS=60000
LOG_LEVEL=info

# Probes:
#   GET /health  liveness  — never touches the database
#   GET /ready   readiness — checks the database, 503 while draining
